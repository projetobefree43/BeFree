{
  "expo": {
    "name": "BeFree",
    "slug": "BeFree",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "befree",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "O BeFree acessa suas fotos para que você possa escolher uma imagem de perfil.",
          "cameraPermission": "O BeFree acessa sua câmera para que você possa tirar uma foto de perfil.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
